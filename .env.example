# ==========================================
# Families Tours - Environment Configuration
# ==========================================

# ------------------------------------------
# 1. Neon PostgreSQL Database Configuration
# ------------------------------------------
DATABASE_URL="postgresql://user:password@ep-sample-pooler.region.aws.neon.tech/neondb?sslmode=require"

# ------------------------------------------
# 2. Cloudflare R2 Object Storage
# ------------------------------------------
R2_ACCOUNT_ID="your_cloudflare_account_id"
R2_ACCESS_KEY_ID="your_r2_access_key_id"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
R2_BUCKET_NAME="familiestours"
R2_PUBLIC_URL="https://cdn.familiestours.com/"

# ------------------------------------------
# 3. Resend Email Notifications
# ------------------------------------------
RESEND_API_KEY="re_your_resend_api_key"
EMAIL_FROM="Families Tours <onboarding@resend.dev>"
ADMIN_EMAIL="info@familiestours.com"

# ------------------------------------------
# 4. Next.js App Configuration
# ------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ------------------------------------------
# 5. Auth
# ------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace_with_a_long_random_secret"
