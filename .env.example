# ==========================================
# Families Tours - Environment Configuration
# ==========================================

# ------------------------------------------
# 1. Neon PostgreSQL Database Configuration
# ------------------------------------------
# Replace with your Neon connection string from https://console.neon.tech
DATABASE_URL="postgresql://user:password@ep-sample-pooler.region.aws.neon.tech/neondb?sslmode=require"

# ------------------------------------------
# 2. Cloudflare R2 Object Storage
# ------------------------------------------
# Get these credentials from Cloudflare Dashboard > R2 > Manage R2 API Tokens
R2_ACCOUNT_ID="your_cloudflare_account_id"
R2_ACCESS_KEY_ID="your_r2_access_key_id"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
R2_BUCKET_NAME="families-tours-images"

# Public URL domain for your R2 bucket (e.g. Custom Domain or R2 Dev Subdomain)
# Example: https://images.familiestours.com OR https://pub-xxxxxxxx.r2.dev
R2_PUBLIC_URL="https://images.familiestours.com"

# ------------------------------------------
# 3. Next.js App Configuration
# ------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
