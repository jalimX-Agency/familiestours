// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum MessageStatus {
  UNREAD
  READ
  ARCHIVED
}

model Booking {
  id           String        @id @default(cuid())
  packageName  String
  customerName String
  email        String
  phone        String?
  date         DateTime
  guests       Int           @default(1)
  message      String?
  totalPrice   Float?
  status       BookingStatus @default(PENDING)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([email])
  @@index([status])
  @@index([date])
}

model ContactMessage {
  id        String        @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String?
  message   String
  status    MessageStatus @default(UNREAD)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([email])
  @@index([status])
}

model TourPackage {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  subtitle    String?
  price       Float
  duration    String
  difficulty  String   @default("Easy")
  groupSize   String?
  highlight   Boolean  @default(false)
  signature   Boolean  @default(false)
  description String
  mainImage   String
  gallery     String[]
  features    String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model GalleryImage {
  id          String   @id @default(cuid())
  key         String   @unique // Cloudflare R2 object key
  url         String   // Public URL or R2 domain URL
  altText     String?
  category    String   @default("General") // Camels, Adventure, Camp, Nature, etc.
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
}

model Review {
  id        String   @id @default(cuid())
  author    String
  location  String
  rating    Int      @default(5)
  tour      String
  text      String
  avatar    String?
  published Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published])
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  role      String   @default("ADMIN")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}